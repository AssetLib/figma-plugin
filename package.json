{
  "name": "@assetlib/figma-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Insert Assetlib images into Figma and send artwork back to placement drafts.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "test": "node scripts/test.mjs",
    "test:browser": "node scripts/build.mjs && node scripts/ui-browser.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "contrast": "node scripts/contrast.mjs",
    "e2e:local": "node scripts/e2e-local.mjs"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.117.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  }
}
